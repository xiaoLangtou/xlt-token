{
  "name": "xlt-token",
  "version": "2.0.0",
  "description": "Framework-agnostic token auth library with NestJS and Express integrations, inspired by Sa-Token",
  "keywords": [
    "auth",
    "jwt",
    "nestjs",
    "session",
    "token"
  ],
  "homepage": "https://xiaolangtou.github.io/xlt-token/",
  "bugs": {
    "url": "https://github.com/xiaoLangtou/xlt-token/issues"
  },
  "license": "MIT",
  "author": "xltorg",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoLangtou/xlt-token.git"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "pnpm --filter @xlt-token/core build && pnpm --filter @xlt-token/nestjs build",
    "build": "tsdown",
    "build:workspace": "turbo run build",
    "build:watch": "tsdown --watch",
    "lint": "oxlint src packages examples docs/.vitepress scripts",
    "lint:fix": "oxlint src packages examples docs/.vitepress scripts --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,mjs,cjs,json,jsonc,yml,yaml}\"",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" --filter \"./examples/*\" --if-present typecheck",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run check:boundaries && pnpm run test:all && pnpm run build:workspace",
    "test": "pnpm --filter @xlt-token/nestjs test",
    "test:watch": "pnpm --filter @xlt-token/nestjs test -- --watch",
    "test:ui": "pnpm --filter @xlt-token/nestjs test -- --ui",
    "test:cov": "pnpm --filter @xlt-token/nestjs test:cov",
    "test:e2e": "pnpm --filter @xlt-token/nestjs test:e2e",
    "test:e2e:cov": "pnpm --filter @xlt-token/nestjs test:e2e:cov",
    "test:all": "pnpm --filter @xlt-token/core test:cov && pnpm --filter @xlt-token/store-redis test:cov && pnpm --filter @xlt-token/express test:cov && pnpm --filter @xlt-token/express test:e2e && pnpm --filter @xlt-token/nestjs test:cov && pnpm --filter @xlt-token/nestjs test:e2e",
    "test:workspace": "turbo run test test:cov test:e2e",
    "test:junit": "vitest run --reporter=junit --outputFile=reports/junit.xml",
    "test:e2e:junit": "pnpm --filter @xlt-token/nestjs test:e2e:junit",
    "prepublishOnly": "pnpm run build:workspace",
    "publish:packages": "pnpm publish -r --access public --no-git-checks",
    "publish:dry-run": "pnpm publish -r --access public --no-git-checks --dry-run",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:build": "pnpm build && vitepress build docs",
    "docs:build:workspace": "turbo run docs:build"
  },
  "dependencies": {
    "@xlt-token/core": "^2.0.0",
    "@xlt-token/nestjs": "^2.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@shikijs/vitepress-twoslash": "2.5.0",
    "@swc/core": "^1.15.30",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "jsonwebtoken": "^9.0.3",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "supertest": "^7.2.2",
    "tsdown": "^0.20.0",
    "turbo": "^2.5.4",
    "typescript": "^5.1.0",
    "unplugin-swc": "^1.5.9",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "jsonwebtoken": "^9.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0",
    "rxjs": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": false
    },
    "rxjs": {
      "optional": false
    },
    "jsonwebtoken": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.15.1"
}
