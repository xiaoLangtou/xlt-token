{
  "name": "@xlt-token/example-nestjs",
  "version": "0.0.1",
  "private": true,
  "description": "Full-feature NestJS example for @xlt-token/nestjs",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:jwt": "XLT_STRATEGY=jwt tsx src/main.ts",
    "start:redis": "XLT_STORE=redis tsx src/main.ts",
    "start:whitelist": "XLT_DEFAULT_CHECK=false tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@xlt-token/core": "workspace:*",
    "@xlt-token/nestjs": "workspace:*",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.1.0"
  },
  "optionalDependencies": {
    "jsonwebtoken": "^9.0.3",
    "redis": "^5.0.0"
  }
}
