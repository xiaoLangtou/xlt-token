{
  "name": "@xlt-token/example-express",
  "version": "2.0.0",
  "private": true,
  "description": "Full-feature Express example for @xlt-token/express",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:whitelist": "XLT_DEFAULT_CHECK=false tsx src/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xlt-token/express": "^2.0.0",
    "express": "^4.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.1.0"
  }
}
