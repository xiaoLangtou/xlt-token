{
  "name": "@xlt-token/jwt",
  "version": "2.2.0",
  "description": "JWT token strategy with key rotation for xlt-token",
  "keywords": [
    "auth",
    "jwt",
    "token",
    "xlt-token"
  ],
  "homepage": "https://xiaolangtou.github.io/xlt-token/",
  "bugs": {
    "url": "https://github.com/xiaoLangtou/xlt-token/issues"
  },
  "license": "MIT",
  "author": "xltorg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoLangtou/xlt-token.git",
    "directory": "packages/jwt"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@xlt-token/core": "^2.2.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsdown": "^0.20.0",
    "typescript": "^5.1.0",
    "vitest": "^2.0.0"
  }
}
