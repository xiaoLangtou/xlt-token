{
  "name": "@xlt-token/store-redis",
  "version": "2.3.0",
  "description": "Framework-agnostic Redis stores for xlt-token",
  "keywords": [
    "auth",
    "ioredis",
    "redis",
    "session",
    "token"
  ],
  "homepage": "https://xiaolangtou.github.io/xlt-token/",
  "bugs": {
    "url": "https://github.com/xiaoLangtou/xlt-token/issues"
  },
  "license": "MIT",
  "author": "xltorg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoLangtou/xlt-token.git",
    "directory": "packages/store-redis"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit --target ES2020 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck --types vitest/globals test/client-types.spec.ts",
    "test": "vitest run",
    "test:types": "tsc --noEmit --target ES2020 --module NodeNext --moduleResolution NodeNext --strict --esModuleInterop --skipLibCheck --types vitest/globals test/client-types.spec.ts",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@xlt-token/core": "^2.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "@xlt-token/store-contract": "^2.3.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.1.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0",
    "redis": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  }
}
