{
  "name": "@xlt-token/adapter-express",
  "version": "0.0.0",
  "description": "Express middleware adapter for xlt-token",
  "keywords": [
    "express",
    "token",
    "auth",
    "session",
    "xlt-token"
  ],
  "author": "xltorg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoLangtou/xlt-token.git",
    "directory": "packages/adapter-express"
  },
  "bugs": {
    "url": "https://github.com/xiaoLangtou/xlt-token/issues"
  },
  "homepage": "https://xiaolangtou.github.io/xlt-token/",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "@xlt-token/core": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "express": "^4.22.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.1.0",
    "vitest": "^2.0.0"
  }
}
